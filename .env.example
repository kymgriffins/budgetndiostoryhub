# Django Secret Key
# Generate a new secret key: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=your-secret-key-here

# Debug Mode (Set to False for production)
DEBUG=True

# Allowed Hosts (comma-separated or leave blank and configure in settings)
ALLOWED_HOSTS=www.budgetndiostory.org,budgetndiostory.org,www.backend.budgetndiostory.org,backend.budgetndiostory.org

# Database Configuration (PostgreSQL)
DB_NAME=budgetnd_budgetndiostory
DB_USER=budgetnd_user
DB_PASSWORD=budgetndiostory
DB_HOST=127.0.0.1
DB_PORT=3306

# CORS Settings
CORS_ALLOWED_ORIGINS=https://www.budgetndiostory.org,https://budgetndiostory.org,https://www.backend.budgetndiostory.org,https://backend.budgetndiostory.org

# CSRF Trusted Origins
CSRF_TRUSTED_ORIGINS=https://www.budgetndiostory.org,https://budgetndiostory.org,https://www.backend.budgetndiostory.org,https://backend.budgetndiostory.org

# Static & Media Files URLs
STATIC_URL=/static/
MEDIA_URL=/media/

# Email Configuration (optional - for sending emails)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Time Zone
TIME_ZONE=Africa/Nairobi
